# PropertyFinder web UI configuration (read by serve.py).
# Copy to .env and adjust. Real environment variables override this file.

# URL of the agent HTTP API. Must match the agent's AGENT_HOST/AGENT_PORT
# (as reachable from the user's browser).
AGENT_URL=http://localhost:8000

# Agent key, sent on every request to the agent in the "x-api-key" header
# (e.g. for the API gateway in front of the agent). Visible in the browser.
# AGENT_API_KEY=

# Address the UI server listens on. Add http://<UI_HOST>:<UI_PORT> to the
# agent's AGENT_CORS_ORIGINS.
UI_HOST=127.0.0.1
UI_PORT=8080
