# ==========================================================
# PropertyFinder configuration. Copy to .env and fill in.
# Use another file with: python cli.py --config <file>  (or server.py)
# Real environment variables override values in this file.
# ==========================================================

# --- OpenAI LLM endpoint ---
OPENAI_API_KEY=sk-...
# OpenAI API URL. Change it to use any OpenAI-compatible endpoint (Azure OpenAI v1,
# an LLM gateway/proxy, a local server, ...). Defaults to https://api.openai.com/v1.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
# "responses" (OpenAI default) or "chat_completions" for endpoints that
# only support the Chat Completions API.
OPENAI_API_MODE=responses
# Set to true when OPENAI_BASE_URL is not OpenAI (traces upload to OpenAI).
# OPENAI_AGENTS_DISABLE_TRACING=true

# --- MCP endpoints (required) ---
PROPERTY_SEARCH_MCP_URL=https://e8f34e4e-e9bb-4799-b725-7173d271fa62-dev.e1-us-east-azure.choreoapis.dev/mohan/property-search/v1.0/mcp
INSURANCE_QUOTER_MCP_URL=https://e8f34e4e-e9bb-4799-b725-7173d271fa62-dev.e1-us-east-azure.choreoapis.dev/mohan/insurance-quoter/v1.0/mcp

# --- Choreo auth (property-search requires it) ---
# Option A: OAuth2 client credentials from the Choreo app subscribed to the API (auto-refreshing)
PROPERTY_SEARCH_CLIENT_ID=
PROPERTY_SEARCH_CLIENT_SECRET=
# PROPERTY_SEARCH_TOKEN_URL=https://sts.choreo.dev/oauth2/token

# Option B: a static access token (expires; handy for quick tests)
# PROPERTY_SEARCH_ACCESS_TOKEN=

# Any auth setting can use the CHOREO_ prefix instead to apply to both servers,
# e.g. CHOREO_CLIENT_ID / CHOREO_CLIENT_SECRET.

# --- HTTP API (server.py) ---
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
# Comma-separated origins allowed to call the API from a browser (where ui/ is served).
AGENT_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Conversation history (SQLite). The folder must be writable; in containers use a
# mounted volume, e.g. /data/sessions.db (falls back to the temp dir if not writable).
# AGENT_SESSIONS_DB=/path/to/sessions.db   (default: agent/sessions.db)
# Request logging: level (DEBUG also logs tool arguments) and whether user
# messages appear in logs (truncated). Set AGENT_LOG_MESSAGES=false to log only lengths.
AGENT_LOG_LEVEL=INFO
AGENT_LOG_MESSAGES=true
